# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data layout:
# - curated JSON in data/raw/*.json (regular git)
# - full Hugging Face cache under data/raw/huggingface (Git LFS for *.arrow)
# - ignore lock files from the datasets library
data/**
!data/raw/
!data/raw/*.json
!data/raw/huggingface/
!data/raw/huggingface/**
!data/processed/
!data/processed/*.jsonl
!data/processed/indexes/
!data/processed/indexes/*.json
!data/processed/indexes/README.md
*.lock
*.incomplete_info.lock

# Large generated indexes (rebuild locally)
*.faiss
*.index
data/processed/indexes/*_meta.jsonl

# macOS
.DS_Store
