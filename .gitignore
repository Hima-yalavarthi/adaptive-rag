# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data layout:
# - curated JSON in data/raw/*.json (regular git)
# - full Hugging Face cache under data/raw/huggingface (Git LFS for *.arrow)
# - ignore lock files from the datasets library
data/**
!data/raw/
!data/raw/*.json
!data/raw/huggingface/
!data/raw/huggingface/**
!data/processed/
!data/processed/.gitkeep
!data/processed/*.jsonl
*.lock
*.incomplete_info.lock

# Downloaded models, caches, and generated indexes (non-dataset)
.cache/
cache/
models/
checkpoints/
*.safetensors
*.pt
*.pth
*.bin
*.faiss
*.index

# macOS
.DS_Store
